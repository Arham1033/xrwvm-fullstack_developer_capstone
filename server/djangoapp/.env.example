# Copy this file to server/djangoapp/.env and fill in YOUR values.
# Never commit the real .env file.

# URL of the Node/Express dealer service (server/database), no trailing slash
backend_url=http://localhost:3030
# URL of the Flask sentiment service (server/djangoapp/microservices)
sentiment_analyzer_url=http://localhost:5050/

# Optional Django settings (read from the process environment)
# DJANGO_SECRET_KEY=change-me
# DJANGO_DEBUG=True
# Comma-separated hostnames Django may serve. For the IBM Skills Network
# lab add the hostname part of YOUR assigned URL (no https://, no path).
# ALLOWED_HOSTS=localhost,127.0.0.1,<your-assigned-hostname>
# Comma-separated origins WITH scheme, e.g. https://<your-assigned-hostname>
# CSRF_TRUSTED_ORIGINS=https://<your-assigned-hostname>
